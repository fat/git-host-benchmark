{
  "localRepo": "./test-data/large-repo",
  "workingDir": "./.benchmark-temp",
  "printSummaryPerConfig": false,
  "targets": {
    "codeStorage": { "enabled": true },
    "github": {
      "enabled": true,
      "owner": "pierre-tester",
      "ownerType": "user",
      "repoPrefix": "git-host-benchmark",
      "visibility": "private"
    }
  },
  "benchmarks": {
    "initialPush": { "enabled": true },
    "clone": { "enabled": true, "concurrency": 5, "iterations": 10 },
    "worktreeCommit": { "enabled": true, "concurrency": 10, "iterations": 20 },
    "parallelPush": { "enabled": true, "concurrency": 5, "iterations": 10 },
    "rampClone": {
      "enabled": false,
      "minConcurrency": 1,
      "maxConcurrency": 20,
      "step": 2,
      "iterations": 10,
      "stopP95Ms": 2000,
      "stopErrorRate": 0.1
    },
    "rampParallelPush": {
      "enabled": true,
      "minConcurrency": 20,
      "maxConcurrency": 60,
      "step": 20,
      "iterations": 50,
      "stopErrorRate": 0.05
    },
    "sdkListFiles": { "enabled": true, "iterations": 50, "concurrency": 1 },
    "sdkCreateCommit": {
      "enabled": true,
      "iterations": 20,
      "fileSizes": [1024, 10240, 102400],
      "filesPerCommit": 1,
      "concurrency": 1
    },
    "sdkDeletePath": { "enabled": true, "iterations": 20, "concurrency": 1 }
  }
}
